{
  "manifest_version": 2,
  "name": "Cardmarket Order Exporter",
  "version": "3.3.0",
  "description": "Scrapes paid Cardmarket orders and exports buyer addresses to CSV + prints Brother DK-11208 (38×90mm) labels with Deutsche Post Internetmarke stamps",

  "permissions": [
    "tabs",
    "downloads",
    "storage",
    "*://*.cardmarket.com/*"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "cm-porto-labeler@local",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_security_policy": "script-src 'self'; object-src 'self'",

  "background": {
    "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": ["*://*.cardmarket.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Cardmarket Order Exporter",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },

  "web_accessible_resources": ["labels.html", "labels.js", "lib/pdf.min.js", "lib/pdf.worker.min.js"],

  "icons": {
    "48": "icons/icon48.png"
  }
}
